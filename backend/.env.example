# Copie este arquivo para backend/.env e preencha. O .env nunca vai para o git.

# PostgreSQL do Supabase (Project Settings -> Database -> Connection parameters)
DB_HOST=
DB_PORT=5432
DB_NAME=postgres
DB_USER=
DB_PASSWORD=

# Segredo que assina os tokens de login e de recuperação de senha (qualquer texto longo e aleatório)
JWT_SECRET=

# Supabase Storage, onde ficam as fotos (bucket "itens")
SUPABASE_URL=
SUPABASE_SECRET_KEY=

# Opcional: endereço do frontend usado no link do e-mail de recuperação
# FRONTEND_URL=http://localhost:5173

# Opcional: envio de e-mail de verdade. Sem isso, o e-mail vai para o Ethereal (caixa de teste)
# e o link para abri-lo aparece no terminal do backend.
# SMTP_HOST=
# SMTP_PORT=587
# SMTP_USER=
# SMTP_PASS=
# SMTP_FROM="AchouUNIFOR" <seu-email@dominio.com>
# Ou, no lugar do SMTP, um serviço conhecido do nodemailer:
# EMAIL_SERVICE=gmail
# EMAIL_USER=
# EMAIL_PASS=
